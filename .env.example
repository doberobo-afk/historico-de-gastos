# ---------------------------------------------------------------------------
# Copie para ".env.local" (desenvolvimento) ou cadastre na Vercel
# (Project > Settings > Environment Variables)
# ---------------------------------------------------------------------------

# Supabase -> Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role

# Proteções opcionais (recomendadas em produção)
# SYNC_TOKEN: exige o header "x-sync-token" em /api/sync
SYNC_TOKEN=
# CRON_SECRET: a Vercel envia automaticamente como "Authorization: Bearer ..."
CRON_SECRET=
# EXTRAIR_TOKEN: exige o header "x-token" em /api/extrair
EXTRAIR_TOKEN=
